# The share service's environment (docker run --env-file share.env). The values are yours: none of them is in the code.
# Keep the real file out of git (the storage key is in it); put it where the other secrets live (SOPS).

# the storage (S3-compatible)
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# 1: https://endpoint/bucket/key (path style), 0: https://bucket.endpoint/key
S3_PATH_STYLE=1
# the link's life, seconds
S3_URL_TTL=900
S3_PREFIX=incoming
# 1: the archive's SHA-256 is a signed header too (x-amz-checksum-sha256), when the storage supports it
SHARE_SIGN_CHECKSUM=0
# 1: /v1/complete downloads the object and checks its SHA-256 (traffic: every archive once more)
SHARE_VERIFY_DOWNLOAD=0

# the service
SHARE_DB=/data/share.sqlite
SHARE_TRUST_PROXY=1
# a long random string (openssl rand -hex 32): the client IPs are kept only as hashes with it
SHARE_IP_SALT=

# the limits, per UTC day
SHARE_MAX_SIZE=209715200
SHARE_PER_INSTALL_DAY=3
SHARE_PER_IP_DAY=10
SHARE_DAY_COUNT=500
SHARE_DAY_BYTES=21474836480
